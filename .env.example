# ─────────────────────────────────────────────────────────────
# 네이버 지도 (필수)
# NAVER Cloud Platform > Maps > Web Dynamic Map 에서 발급
# 콘솔에서 Web 서비스 URL 에 http://localhost:3000 을 반드시 등록해야 합니다.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
#
# 구버전(ncpClientId) 키를 쓰는 경우에만 legacy 로 변경
# NEXT_PUBLIC_NAVER_MAP_AUTH_PARAM=legacy

NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 네이버 지오코딩 (선택 — npm run arcades:regeocode 전용)
#
# 지역 검색(위 NAVER_SEARCH_*)이 주는 좌표는 업체 대표 포인트라 건물 중심에
# 가깝게 잡히는 경우가 많습니다. 이 API는 저장된 **주소 문자열**을 다시 조회해
# 더 정확한 좌표로 보정합니다 (scripts/regeocode-arcades.ts).
#
# 발급: NCP 콘솔 > Services > Maps > 위 NEXT_PUBLIC_NAVER_MAP_KEY_ID 를 발급받은
#       그 애플리케이션에서 "Geocoding" API 이용 신청 → Client Secret 발급
#   Client ID 는 NEXT_PUBLIC_NAVER_MAP_KEY_ID 를 그대로 씁니다 (따로 안 넣어도 됨).
NAVER_MAP_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# DB (선택)
# 비워두면 PGlite(내장 Postgres, .pglite/ 디렉터리)로 자동 실행됩니다.
# 실제 Postgres 를 쓰려면 아래 주석을 해제하세요. SQL 은 동일합니다.
#
# 채워 두고도 그 서버에 **못 붙으면** .pglite/ 로 내려가 앱이 그대로 뜹니다.
# 그러려면 사본을 미리 떠 둬야 합니다 — `npm run db:snapshot -- --yes`.
# 내려간 동안 쓴 내용은 PostgreSQL 에 반영되지 않습니다 (README 의 DB 절 참고).
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arcade_finder

# 폴백 스위치. 비워 두면 **개발에서만 켜지고 운영(NODE_ENV=production)은 꺼집니다.**
# 운영에서 사본에 쓰면 인스턴스마다 다른 데이터가 쌓여 어느 쪽도 정본이 아닙니다.
# 운영에서 굳이 켜려면 on — 다만 /api/health 가 폴백 중 503 을 돌려 프록시가 그 인스턴스를 뺍니다.
# DB_FALLBACK=off

# 첫 연결 확인에 쓰는 제한 시간(ms). 이 시간 안에 못 붙으면 사본으로 내려갑니다.
# PG_CONNECT_TIMEOUT_MS=3000

# ─────────────────────────────────────────────────────────────
# 관리자 계정 (오락실 정보 수정 · 제보 삭제)
#
# 계정의 근거는 DB 가 아니라 이 파일입니다. 로그인할 때 players 에 없으면
# 만들고, 비밀번호가 다르면 갱신합니다 (lib/auth.ts ensureAdminAccount).
# 즉 비밀번호를 바꾸려면 아래 값만 고치고 다시 로그인하면 됩니다.
#
# 개발 환경에서 ADMIN_PASSWORD 를 비워두면 'admin1234' 로 동작합니다.
# NODE_ENV=production 에서는 비워두면 로그인 자체가 막힙니다(503).
# ─────────────────────────────────────────────────────────────
# ADMIN_NICKNAME=관리자
# ADMIN_PASSWORD=

# 세션 쿠키 서명 키 (16자 이상). 운영에서는 필수입니다 —
# 없으면 서버가 뜰 때가 아니라 로그인/권한 확인 시점에 에러가 납니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# ─────────────────────────────────────────────────────────────
# 소셜 로그인 (선택 · Google · 카카오 · 네이버)
#
# 키를 넣은 제공자만 실제로 동작합니다. 버튼은 항상 보이지만, 키가 없는 곳을
# 누르면 제공자로 보내지 않고 "아직 준비되지 않은 로그인 방식" 안내와 함께
# 로그인 화면으로 되돌립니다 (app/api/auth/oauth/[provider]/route.ts).
#
# ⚠ 셋 다 NEXT_PUBLIC_ 이 아닙니다. 토큰 교환은 전부 서버에서 하므로 이 값들이
#   브라우저로 나가서는 안 됩니다.
#
# 콜백(Redirect) 주소는 셋 다 같은 모양입니다 — 콘솔에 **글자 하나까지 똑같이**
# 등록해야 합니다:
#   http://localhost:3000/api/auth/oauth/google/callback
#   http://localhost:3000/api/auth/oauth/kakao/callback
#   http://localhost:3000/api/auth/oauth/naver/callback
#
# 운영에서는 아래 APP_URL 을 도메인으로 못박으세요. 비워 두면 요청 헤더(Host)로
# 콜백 주소를 유추하는데, 프록시 뒤에서는 내부 주소가 잡혀 콘솔에 등록한 것과
# 달라지고 토큰 교환이 실패합니다.
# ─────────────────────────────────────────────────────────────
# APP_URL=https://arcade.example.com

# Google — https://console.cloud.google.com/apis/credentials
#   '사용자 인증 정보 만들기' > 'OAuth 클라이언트 ID' > 웹 애플리케이션
#   · 승인된 리디렉션 URI 에 위 google/callback 주소 등록
#   · OAuth 동의 화면에서 범위 email · profile 추가 (기본 제공)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 카카오 — https://developers.kakao.com/console/app
#   · 앱 키의 **REST API 키** 입니다 (JavaScript 키가 아닙니다)
#   · 카카오 로그인 > 활성화 ON, Redirect URI 에 위 kakao/callback 주소 등록
#   · 동의항목에서 '닉네임' 을 필수 또는 선택으로 켜기
#     (이메일은 비즈 앱 심사를 통과해야 켤 수 있습니다. 이 앱은 이메일 없이도
#      동작하므로 요청 범위에 넣지 않습니다 — lib/oauth.ts 주석 참고)
#   · 보안 > Client Secret 을 '사용함' 으로 켠 경우에만 아래 값을 채우세요.
#     끄고 쓰면 KAKAO_CLIENT_SECRET 은 비워 두면 됩니다.
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 오락실 목록 가져오기 · 네이버 지역 검색 (선택)
#
# npm run arcades:import 가 쓰는 키입니다. 실제 오락실의 **이름·주소·좌표**를
# 네이버에서 가져옵니다.
#
# ⚠ 2026-07-31 로 developers.naver.com 의 검색 API 지원이 끝났습니다.
#   지역 검색은 **NAVER API HUB**(네이버 클라우드 플랫폼 콘솔)로 이관됐고,
#   자격증명도 NCP API Gateway 키로 바뀌었습니다.
#     구:  openapi.naver.com          (X-Naver-Client-Id / Secret)
#     신:  naverapihub.apigw.ntruss.com (X-NCP-APIGW-API-KEY-ID / -KEY)
#
# ⚠ 섞이기 쉬운 키가 셋 있습니다. 서로 다른 값입니다:
#     1. 아래 두 값                    — NCP 콘솔 > NAVER API HUB
#     2. NEXT_PUBLIC_NAVER_MAP_KEY_ID  — 지도를 '그리는' NCP Maps 키 (맨 위)
#     3. NAVER_CLIENT_ID/SECRET        — 네이버 '로그인'(OAuth) 용 (아래)
#   2·3번으로는 검색이 되지 않습니다 (401).
#
# ⚠ **영업시간은 이 API 로 가져올 수 없습니다.** 응답에 그런 필드가 없습니다
#   (telephone 도 항상 빈 문자열입니다). 수입한 오락실의 영업시간은 '정보 없음'
#   으로 들어가고, 확인용 네이버 지도 검색 링크가 arcades.source_ref 에 남습니다.
#   관리자 화면에서 채우세요. 자세한 사정은 lib/naver-local.ts 참고.
#
# 발급: NCP 콘솔 > Services > NAVER API HUB 에서 검색(지역) API 이용 신청 후
#       API Key ID / API Key 를 아래에 넣으세요.
#
# 이관 전 이름(NAVER_SEARCH_CLIENT_ID/SECRET)도 그대로 인식합니다 — 이미 채워 둔
# 설정이 있으면 굳이 바꾸지 않아도 됩니다.
# ─────────────────────────────────────────────────────────────
# NAVER_HUB_API_KEY_ID=
# NAVER_HUB_API_KEY=

# 네이버 — https://developers.naver.com/apps/#/register
#   · 사용 API 에서 '네이버 로그인' 선택, 제공 정보는 회원이름/이메일/별명 중
#     필요한 것만 (이 앱은 별명만 씁니다)
#   · 서비스 URL: http://localhost:3000
#   · Callback URL 에 위 naver/callback 주소 등록
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 브이월드(VWorld) 건물통합정보 — 건물 중심 좌표 보정 (선택 · npm run arcades:regeocode-building 전용)
#
# 네이버 지역 검색·지오코딩 둘 다 "도로명주소가 가리키는 출입구 지점"을 주기 때문에,
# 건물 폴리곤 자체의 중심으로 보정하려면 이 API가 따로 필요합니다.
#
# 발급: https://www.vworld.kr 회원가입 > 오픈API > 인증키 신청
#   · 활용 목적: 개인/학습, 서비스 URL(도메인): localhost 를 등록하면 로컬에서도 동작
#   · 발급된 인증키를 아래에 넣습니다
#
# 정확한 데이터셋 ID·응답 필드는 문서만으로 확정하기 어려워, 키가 준비되면
# `npm run arcades:vworld-test` 로 샘플 좌표 하나를 먼저 테스트 조회해 원본
# 응답을 확인합니다 (scripts/vworld-test.ts).
# ─────────────────────────────────────────────────────────────
# VWORLD_API_KEY=

# ─────────────────────────────────────────────────────────────
# 챗봇 (선택)
#
# 오른쪽 아래 도우미의 **자유 질문**에만 씁니다. 우선순위 탐색(1·2·3순위 →
# 지도 표시)은 전부 브라우저에서 계산하므로 키 없이도 그대로 동작합니다.
# 키가 없으면 자유 질문만 503 과 함께 안내 문구를 돌려줍니다.
#
# https://aistudio.google.com/apikey 에서 발급
# ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# 공공데이터포털 — 게임업소 인허가 (선택 · npm run games:localdata 전용)
#
# 네이버 지역 검색이 "지금 지도에 뜨는 가게"를 주는 것과 달리, 이쪽은 지자체
# 인허가 원부라 **영업상태·폐업일자·인허가일자·총게임기수**가 들어 있습니다.
# 그래서 '영업중인 오락실'을 가려내는 근거로는 이게 더 정확합니다.
#
# 지금 붙여 둔 것은 **청소년게임제공업(전체이용가)** 하나입니다 — 인형뽑기·오락실이
# 여기 들어갑니다. 이 개방서비스에 활용신청하고 키를 받으세요:
#   https://www.data.go.kr/data/15154958/openapi.do   (lib/localdata-games.ts)
#
# 게임업소는 인허가 업종이 4개로 쪼개져 있습니다. 나중에 커버리지를 넓히고 싶으면
# 아래도 같은 모양(apis.data.go.kr/1741000/{slug}/info)이라 lib 을 그대로 재사용할 수
# 있습니다. 리듬게임 기체는 복합유통게임제공업에 등록된 곳도 있습니다.
#   일반게임제공업(18세이용가)  15154955  general_game_providers
#   복합유통게임제공업          15154945  mixed_game_providers
#   인터넷컴퓨터게임시설(PC방)  15154951  pc_bangs
#
# ⚠ 업종마다 **따로 활용신청**해야 합니다 (자동승인, 무료). 키는 계정에 하나라
#   아래 값 하나로 넷 다 쓸 수 있지만, 신청하지 않은 업종은 "등록되지 않은
#   서비스키" 로 거부됩니다 — 키가 틀린 게 아닙니다.
# ⚠ **일반 인증키(Decoding)** 를 넣으세요. Encoding 값을 넣어도 스크립트가
#   되돌리지만, Decoding 이 원칙입니다.
# ⚠ 개발계정 트래픽 하루 10,000회. 한 업종 전국이 100~200회면 끝납니다.
# ⚠ 응답의 좌표(CRD_INFO_X/Y)는 위경도가 아니라 EPSG:5174(중부원점TM)입니다.
#   지도에 올릴 땐 도로명주소를 lib/naver-geocode.ts 로 다시 지오코딩하세요.
#
# 발급: 위 링크에서 [활용신청] → 마이페이지 > 오픈API > 인증키
# ─────────────────────────────────────────────────────────────
# DATA_GO_KR_API_KEY=

# ─────────────────────────────────────────────────────────────
# 신뢰하는 프록시 홉 수 (선택 · 기본 0)
#
# 클라이언트와 앱 사이에 **내가 운영하는** 프록시가 몇 대인가. 로그인·가입
# 시도 제한이 이 값으로 실제 클라이언트 주소를 짚습니다 (lib/auth.ts clientKey).
#
# `X-Forwarded-For` 는 클라이언트가 마음대로 보낼 수 있어서, 왼쪽부터 읽으면
# **공격자가 잠금 키를 고르게 됩니다.** 그래서 오른쪽에서 이 수만큼 세어
# 프록시가 덧붙인 값만 믿습니다.
#
#   0 (기본)  프록시 없음 — IP 로는 세지 않습니다. 로그인은 계정 단위로 셉니다
#   1         `npm run start:cluster` (스크립트가 자동으로 넣어 줍니다)
#   2         그 앞에 nginx 를 더 둔 경우
#
# ⚠ 실제보다 크게 주면 안 됩니다 — 위조된 값을 믿게 됩니다.
# ─────────────────────────────────────────────────────────────
# TRUSTED_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────────
# DB 커넥션 풀 상한 (선택 · 기본 30 · 운영 권고 10)
#
# **올리지 마세요.** 목표 규모(가입자 10,000 · DAU 3,000) 부하에서 실제로 열리는
# 커넥션은 4~5개이고 그중 활성은 0~1개입니다. 풀 30 과 10 을 두 포트에 동시에
# 띄우고 번갈아 재도 p95 가 158.0 대 157.1ms 로 차이가 없습니다
# (PERFORMANCE.md 4부 15절).
#
# 기본값이 30 인 것은 상한이 **할당이 아니라 천장**이라 놔둬도 비용이 0 이기
# 때문입니다. 다만 운영에서는 10 을 명시하는 쪽을 권합니다 — 슬롯 하나가
# Postgres 메모리 22~23MB 이고, max_connections(기본 100) 아래에서 앱 인스턴스를
# 몇 개 띄울 수 있는지가 이 값으로 정해집니다.
#
#   풀 10 × 인스턴스 2 = 20  → 권고 구성. 인스턴스 9개까지 여유
#   풀 30 × 인스턴스 3 = 90  → 여기서 꽉 찹니다
#
# `npm run start:cluster` 는 인스턴스당 10 을 자동으로 넣습니다
# (scripts/start-cluster.mjs). 이 항목을 직접 설정하면 그 값이 우선합니다.
# ─────────────────────────────────────────────────────────────
# PG_POOL_MAX=30

# ─────────────────────────────────────────────────────────────
# Pulse 앱 계측 (선택) — https://github.com/mick243/pulse
#
# 두 값이 다 있어야 켜집니다. 켜지면 요청마다 라우트·상태코드·소요시간을,
# 쿼리마다 지문·소요시간·성공 여부를 메모리에 모아 30초마다 Pulse 로 보냅니다
# (lib/telemetry.ts). 비워 두면 계측 코드가 전혀 실행되지 않습니다.
#
# 키는 Pulse 대시보드에서 AGENT 대상을 추가하면 한 번 보여줍니다.
# 가동 여부·폴백 감지는 이것과 별개로 /api/health 를 PROBE 대상으로 등록하세요.
# ─────────────────────────────────────────────────────────────
# PULSE_API_URL=http://localhost:4000
# PULSE_AGENT_KEY=
# PULSE_AGENT_ID=arcade-finder

# ─────────────────────────────────────────────────────────────
# 운영자 정보 — 이용약관(/terms) · 개인정보처리방침(/privacy) · 가입 화면에 찍힙니다
#
# 비워 두면 화면에 "[운영자명 — …]" 자리표시자와 경고가 그대로 보입니다 — 조용히
# 숨기지 않는 것이 의도입니다 (빠진 채로 출시되지 않도록). lib/legal.ts
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-09-13

# ─────────────────────────────────────────────────────────────
# 사용량 한도 (선택 — 기본값이 곧 권고값. rate_counters 표, lib/rate-limit.ts)
#
# 챗봇: 로그인 필수 + 사람마다 하루 N회 + 전체 하루 M회. 요청 1건 = 모델 호출 최대 8회
#       + 구글 검색이라 무제한이면 청구가 폭발합니다.
# 제보: 10분 창. 로그인은 사람마다, 익명은 신뢰 IP 마다, IP 를 모르면 오락실마다.
# 기종 AI 추정: 하루 창. 한 번이 구글 검색 1회 + 토큰 2,700여 개입니다. 출시 전이라
#       누구나 누를 수 있게 열어 뒀고(하루 1회), 전체 한도가 마지막 방벽입니다.
#       관리자는 세지 않습니다. 출시 때 0 으로 내리면 일반 사용자에겐 닫힙니다.
# ─────────────────────────────────────────────────────────────
# CHAT_DAILY_LIMIT=40
# CHAT_GLOBAL_DAILY_LIMIT=2000
# REPORT_LIMIT_PER_PLAYER=30
# REPORT_LIMIT_PER_IP=15
# REPORT_LIMIT_ANON_PER_ARCADE=20
# GUESS_LIMIT_PER_PLAYER=1
# GUESS_LIMIT_PER_IP=1
# GUESS_LIMIT_ANON_PER_ARCADE=1
# GUESS_LIMIT_GLOBAL=200

# 리뷰 AI 요약(lib/review-summary.ts) — 하루에 만들 수 있는 요약 수(전체).
# 리뷰가 바뀐 오락실을 처음 여는 사람이 한 번 만들고, 그 뒤로는 저장된 것을 읽습니다.
# REVIEW_SUMMARY_LIMIT_GLOBAL=200

# ─────────────────────────────────────────────────────────────
# 앱이 뜰 때 소식 동기화 (instrumentation.ts → lib/news-sync-boot.ts)
#
# 기본은 켜짐입니다. 남의 사이트를 긁는 일이라 **N 시간에 한 번만** 실제로 돕니다 —
# dev 서버를 하루에 수십 번 재시작해도 요청은 그만큼 나가지 않습니다(rate_counters
# 'news:sync'). 정본은 하루 한 번 도는 작업 스케줄러(scripts/sync-news.cmd)입니다.
# ─────────────────────────────────────────────────────────────
# NEWS_SYNC_ON_START=0          # 끄기
# NEWS_SYNC_MIN_HOURS=6         # 이 시간 안에 이미 돌았으면 건너뜀 (최대 24)
# NEWS_SYNC_START_DELAY_MS=5000 # 기동 직후 이만큼 기다렸다 시작

# ─────────────────────────────────────────────────────────────
# 운영 필수 (NODE_ENV=production 에서 없으면 서버가 뜨지 않습니다 — lib/env-check.ts)
#   AUTH_SECRET · DATABASE_URL · ADMIN_PASSWORD · APP_URL · TRUSTED_PROXY_HOPS(≥1)
# 로컬에서 운영 빌드를 잠깐 띄워 볼 때만 ENV_CHECK=off 로 건너뛸 수 있습니다 (배포에서는 금지).
# 배포 절차는 deploy/README.md · 앱(PWA) 은 docs/PWA.md
# ─────────────────────────────────────────────────────────────

# 인증 메일 (선택) — https://resend.com
#
# 가입할 때 적은 이메일이 본인 것인지 확인하는 메일을 보냅니다
# (lib/mailer.ts · lib/email-verify.ts). SMTP 클라이언트를 넣지 않고 HTTP API 를
# 쓰는 이유는 패키지가 0개 늘기 때문입니다 — 다른 제공자로 옮겨도 lib/mailer.ts
# 한 파일만 바뀝니다.
#
# 비워 두면:
#   - 개발  : 발송 대신 **서버 콘솔에 링크를 찍습니다.** 메일 계정 없이 확인
#             흐름을 끝까지 밟아 볼 수 있습니다.
#   - 운영  : 보내지 않고 에러 로그만 남깁니다 (조용히 성공한 척하면 "메일이
#             안 와요" 의 원인을 못 찾습니다).
#
# ⚠ MAIL_FROM 의 도메인은 Resend 에서 **인증(DNS 등록)** 해야 실제로 나갑니다.
#   인증 전에는 제공자가 주는 onboarding@resend.dev 로만 보낼 수 있고, 그것도
#   가입한 본인 주소로만 갑니다 — 남에게 보내면 403 이 옵니다.
# ⚠ 링크의 앞부분은 APP_URL 이 정합니다 (lib/app-url.ts). 운영에서 비워 두면
#   프록시 뒤 내부 주소가 메일에 실려 나가 사용자가 열 수 없습니다.
#   OAuth 콜백 주소와 같은 값을 씁니다.
#
# 키 발급: Resend 가입 → API Keys → Create
# ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# MAIL_FROM=오락실 파인더 <noreply@example.com>
