{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arcade-finder",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "arcade-finder-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "ENV_CHECK": "off"
      }
    }
  ]
}
